{
  "name": "suha-care",
  "version": "1.0.0",
  "description": "Suha Care - Hospital, Doctor & Lab Booking Application with SQLite Backend",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "build:apk": "npm run build && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "server": "node backend/server.js"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/sqlite3": "^3.1.11",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  }
}
